# LaunchOpsPro local configuration
# Copy to .env and replace required values. Never commit .env.

# Runtime and API security
LAUNCHOPS_API_KEYS=replace_with_one_or_more_random_keys
LAUNCHOPS_DEV_MODE=false
DASHBOARD_ORIGIN=http://localhost:3000
MOCK_MODE=false

# Platform authentication: secure by default
JWT_SECRET=replace_with_at_least_32_random_bytes
OWNER_OPEN_ID=replace_with_owner_open_id
AUTH_BYPASS_ENABLED=false
VITE_AUTH_DISABLED=false
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# LLM routing: configure at least one provider for live agent execution
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=
DEFAULT_LLM_MODEL=
BUILT_IN_FORGE_API_URL=https://api.openai.com
BUILT_IN_FORGE_API_KEY=

# ProofGuard integration
PROOFGUARD_API_URL=http://localhost:3000
PROOFGUARD_API_KEY=
ENABLE_HUMAN_APPROVAL=true
PROOFGUARD_HITL_TIMEOUT=3600
PROOFGUARD_POLL_INTERVAL=5

# MySQL. URL-encode special characters in DATABASE_URL.
DB_PASSWORD=replace_with_random_database_password
DB_ROOT_PASSWORD=replace_with_random_root_password
DATABASE_URL=mysql://launchops:replace_with_url_encoded_password@mysql:3306/launchops

# Secrets and external integration
VAULT_ADMIN_TOKEN=replace_with_random_vault_token
EXTERNAL_MCP_TOKEN=
OPENCLAW_WS_URL=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_SESSION_KEY=agent:main:main
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Deployment
DOMAIN=localhost
FOUNDER_EDITION_DIR=.

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
